{
  "name": "desktop-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "description": "A local-first desktop AI agent powered by GitHub Copilot SDK and CodeBuddy SDK.",
  "scripts": {
    "dev": "npm run build:sandbox && electron-vite dev",
    "build": "electron-vite build && npm run build:sandbox",
    "build:sandbox": "node scripts/copy-sandbox.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test tests/runtime-policy.test.ts tests/rust-policy.test.ts",
    "package": "npm run typecheck && npm run test && npm run build && npm run package:rust-sandbox && electron-builder --publish never",
    "package:rust-sandbox": "node scripts/package-rust-sandbox.mjs --require"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@microsoft/mxc-sdk": "1.1.0",
    "@ant-design/x": "^2.9.0",
    "@github/copilot-sdk": "^1.0.17",
    "@tencent-ai/agent-sdk": "0.3.276",
    "antd": "^6.6.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@ant-design/x-markdown": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "build": {
    "appId": "com.saga.desktopagent",
    "productName": "Desktop Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "out/sandbox/**",
      "**/node_modules/@microsoft/mxc-sdk/**",
      "**/node_modules/koffi/**",
      "**/node_modules/node-pty/**",
      "**/node_modules/semver/**"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "binaries": [
        "Contents/Resources/rust-sandbox/rust-toolchain/bin/rustc",
        "Contents/Resources/rust-sandbox/rust-toolchain/bin/cargo",
        "Contents/Resources/rust-sandbox/rust-toolchain/lib/**/*.dylib",
        "Contents/Resources/rust-sandbox/rust-toolchain/lib/rustlib/**/bin/rust-lld",
        "Contents/Resources/rust-sandbox/wasmtime/wasmtime"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "extraResources": [
      {
        "from": "resources/rust-sandbox",
        "to": "rust-sandbox",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
